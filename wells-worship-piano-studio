<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#071426">
<title>Wells Worship Piano Studio</title>
<style>
:root{--bg:#071426;--panel:#0d1d33;--panel2:#102541;--line:#263b56;--gold:#e7bd62;--gold2:#ffe2a0;--text:#f7f5ef;--muted:#aab8cb;--green:#63d8a0;--red:#f07979;color-scheme:dark}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;background:radial-gradient(ellipse at 50% -15%,#1a3556 0%,#0a1a2e 43%,var(--bg) 78%) fixed,var(--bg);color:var(--text);font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;min-height:100vh;padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom)}
button,input{font:inherit}button{cursor:pointer;color:inherit}
button:focus-visible,input:focus-visible{outline:2px solid var(--gold2);outline-offset:2px}
.app{max-width:920px;margin:auto;padding:14px 14px 96px}
header{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:7px 2px 17px}
.brand{display:flex;align-items:center;gap:11px;min-width:0}
.logo{width:44px;height:44px;flex:none;border:1px solid #9c7b3d;border-radius:14px;background:linear-gradient(145deg,#1a2e48,#091525);display:grid;place-items:center;color:var(--gold);font-size:23px;box-shadow:0 0 25px #e7bd6214}
.brand h1{font-size:14px;line-height:1.25;letter-spacing:1.1px;margin:0;font-weight:850}
.brand p{margin:4px 0 0;font-size:10px;color:var(--gold);letter-spacing:.5px}
.iconbtn{width:42px;height:42px;border:1px solid var(--line);border-radius:13px;background:#10233b;color:var(--gold);font-size:20px}
.eyebrow{font-size:10px;letter-spacing:2px;color:var(--gold);font-weight:800;margin-bottom:10px}
.sectionhead{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:5px 1px 10px}
.sectionhead h2{font-size:13px;letter-spacing:1px;margin:0}
.sectionhead span{font-size:10px;color:var(--muted)}
.instruments{display:flex;gap:9px;overflow-x:auto;padding:2px 1px 12px;scrollbar-width:thin}
.instrument{min-width:105px;max-width:120px;flex:1;border:1px solid var(--line);border-radius:15px;background:linear-gradient(150deg,#132842,#0b192c);padding:12px 8px 10px;text-align:center;transition:.15s}
.instrument .symbol{font-size:25px;display:block;margin-bottom:8px}
.instrument .name{font-size:11px;font-weight:700;white-space:nowrap}
.instrument.active{border-color:var(--gold);box-shadow:inset 0 0 0 1px #e7bd6240,0 7px 22px #e7bd6212;background:linear-gradient(145deg,#243653,#14243a)}
.instrument.active .name{color:var(--gold2)}
.panel{border:1px solid var(--line);border-radius:18px;background:linear-gradient(145deg,#10233aee,#0a192cee);padding:13px;margin-top:10px;box-shadow:0 12px 35px #00000016}
.statusrow{display:flex;align-items:center;gap:10px}
.midistatus{display:flex;align-items:center;gap:9px;flex:1;min-width:0}
.midistatus>div{min-width:0}
.dot{width:9px;height:9px;border-radius:50%;background:var(--red);box-shadow:0 0 12px #f0797950;flex:none}
.dot.ok{background:var(--green);box-shadow:0 0 12px #63d8a060}
.midistatus strong{font-size:12px;display:block}
.midistatus small{font-size:10px;color:var(--muted);display:block;margin-top:3px;overflow-wrap:anywhere}
.pill{border:1px solid #35506c;border-radius:10px;padding:8px 10px;font-size:10px;color:var(--muted);background:#0a1829}
.transport{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin-top:12px}
.control{border:1px solid var(--line);background:#122640;border-radius:12px;min-height:58px;padding:8px 3px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;font-size:10px}
.control .ico{font-size:18px;color:var(--gold);transition:transform .08s}
.control.on{border-color:var(--gold);background:#2a2b2b}
.control.beat .ico{transform:scale(1.35);color:var(--gold2)}
.control.record .ico{color:#ff7777}
.control.record.on{border-color:#ff7777;background:#2e1c24}
.control.record.on .ico{animation:pulse 1s infinite}
.control.playing{border-color:var(--green)}
@keyframes pulse{50%{opacity:.35}}
.tunings{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.tuningtitle{font-size:11px;color:var(--muted);margin-bottom:9px}
.octaves{display:flex;align-items:center;gap:10px}
.smallbtn{width:34px;height:34px;border-radius:10px;border:1px solid #3a4d65;background:#152b45;color:var(--gold);font-size:18px}
.octavevalue{font-size:13px;min-width:24px;text-align:center;font-weight:750}
.toggleline{display:flex;align-items:center;justify-content:space-between;gap:7px}
.switch{width:42px;height:24px;border-radius:20px;border:1px solid #4a5c72;background:#26374a;padding:3px;display:flex;align-items:center;flex:none}
.switch::after{content:"";width:16px;height:16px;border-radius:50%;background:#b5c0cc;transition:.15s}
.switch.active{background:#755a24;border-color:var(--gold);justify-content:flex-end}
.switch.active::after{background:var(--gold2)}
.sliders{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:17px}
.sliderlabel{display:flex;justify-content:space-between;gap:8px;font-size:11px;margin-bottom:7px}
.sliderlabel span:last-child{color:var(--gold2);font-variant-numeric:tabular-nums}
input[type=range]{width:100%;accent-color:var(--gold);margin:0}
.keyboardpanel{margin-top:12px;padding:12px 9px 14px;overflow:hidden}
.keytop{display:flex;justify-content:space-between;align-items:center;gap:8px;margin:0 3px 11px}
.keytop strong{font-size:12px;letter-spacing:.6px}
.keytop span{font-size:10px;color:var(--muted);text-align:right}
.keys{height:174px;position:relative;overflow-x:auto;overflow-y:hidden;padding:0 1px 2px;touch-action:pan-x;scrollbar-width:thin;scrollbar-color:#40536c #0b1829;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
.keyinner{position:relative;display:flex;height:160px;width:max(100%,588px)}
.whitekey{height:160px;min-width:0;flex:1 1 0;background:linear-gradient(90deg,#d7dbe0,#fff 18%,#f5f5f1 88%,#c7cbd1);border:1px solid #aeb5bf;border-radius:0 0 6px 6px;position:relative;color:#77808b;display:flex;align-items:flex-end;justify-content:center;padding:0 0 7px;font-size:9px;box-shadow:inset 0 -7px 8px #9ca3ad35;touch-action:pan-x}
.whitekey.pressed{background:linear-gradient(#ffe7a4,#e7bd62);transform:translateY(1px)}
.blackkey{position:absolute;z-index:2;top:0;height:99px;width:calc(100% / 14 * .6);background:linear-gradient(90deg,#05090f,#202a38 48%,#060b12);border:1px solid #05090d;border-radius:0 0 5px 5px;box-shadow:0 5px 6px #0008;transform:translateX(-50%);padding:0;touch-action:pan-x}
.blackkey.pressed{background:linear-gradient(#ac843d,#493516)}
.bottomnav{position:fixed;bottom:0;left:0;right:0;z-index:10;padding:8px 10px calc(8px + env(safe-area-inset-bottom));background:#081426f2;border-top:1px solid #293c54;-webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);display:grid;grid-template-columns:repeat(4,1fr);max-width:920px;margin:auto}
.navitem{border:0;background:transparent;color:#93a5bb;padding:6px 2px;display:flex;align-items:center;flex-direction:column;gap:4px;font-size:10px}
.navitem .navico{font-size:19px}
.navitem.active{color:var(--gold2)}
.navitem.active::after{content:"";width:22px;height:2px;border-radius:2px;background:var(--gold);margin-top:1px}
.page{display:none}.page.active{display:block}
.note{font-size:10px;color:var(--muted);line-height:1.5;margin:10px 3px 0}
.settingsrow{display:flex;justify-content:space-between;align-items:center;padding:13px 0;border-bottom:1px solid #24374f;font-size:12px;gap:10px}
.settingsrow:last-child{border-bottom:0}
.actionbtn{border:1px solid var(--line);border-radius:10px;background:#142a44;padding:9px 12px;font-size:11px}
.lastnote{margin-top:12px;border:1px dashed #35506c;border-radius:12px;padding:11px 12px;font-size:12px;color:var(--gold2);font-variant-numeric:tabular-nums;min-height:40px}
.toast{position:fixed;left:50%;bottom:88px;transform:translateX(-50%);background:#f1d28c;color:#172237;padding:9px 14px;border-radius:11px;font-size:12px;font-weight:700;z-index:30;box-shadow:0 8px 30px #0007;display:none;max-width:90%;text-align:center}
@media(min-width:600px){.app{padding:24px 22px 110px}.brand h1{font-size:16px}.instrument{min-width:0}.keys{height:205px}.keyinner{height:190px}.whitekey{height:190px}.blackkey{height:116px}.panel{padding:16px}.control{min-height:62px}}
@media(max-width:370px){.app{padding-left:9px;padding-right:9px}.brand h1{font-size:12px}.instrument{min-width:96px}.keys{height:150px}.keyinner{height:138px}.whitekey{height:138px}.blackkey{height:86px}.control{font-size:9px}.panel{padding:10px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body>
<div class="app">
<header>
  <div class="brand"><div class="logo">𝄞</div><div><h1>WELLS WORSHIP<br>PIANO STUDIO</h1><p>Jouez · Adorez · Élevez Sa présence</p></div></div>
  <button class="iconbtn" id="settingsShortcut" aria-label="Réglages">⚙</button>
</header>

<section id="page-piano" class="page active">
  <div class="eyebrow">VOTRE ESPACE MUSICAL</div>
  <div class="sectionhead"><h2>INSTRUMENTS</h2><span>Des sons pour l’adoration</span></div>
  <div class="instruments">
    <button class="instrument active" data-sound="piano"><span class="symbol">🎹</span><span class="name">Piano</span></button>
    <button class="instrument" data-sound="soft"><span class="symbol">🎼</span><span class="name">Piano doux</span></button>
    <button class="instrument" data-sound="pad"><span class="symbol">☁️</span><span class="name">Pad Worship</span></button>
    <button class="instrument" data-sound="organ"><span class="symbol">🎛️</span><span class="name">Orgue Gospel</span></button>
    <button class="instrument" data-sound="strings"><span class="symbol">🎻</span><span class="name">Strings</span></button>
  </div>

  <div class="panel">
    <div class="statusrow">
      <div class="midistatus"><span class="dot" id="midiDot"></span><div><strong>Connexion MIDI</strong><small id="midiStatus">Non connecté</small></div></div>
      <button class="pill" id="midiConnect">USB MIDI · Vérifier</button>
    </div>
    <div class="transport">
      <button class="control" id="metronome" aria-pressed="false"><span class="ico">♩</span><span id="metroLabel">Métronome</span></button>
      <button class="control record" id="record" aria-pressed="false"><span class="ico">⏺</span><span id="recordLabel">Enregistrer</span></button>
      <button class="control" id="play"><span class="ico">▶</span><span>Lecture</span></button>
      <button class="control" id="stop"><span class="ico">■</span><span>Arrêt</span></button>
    </div>
  </div>

  <div class="panel">
    <div class="tunings">
      <div><div class="tuningtitle">Octave</div><div class="octaves"><button class="smallbtn" id="octDown" aria-label="Octave précédente">−</button><span class="octavevalue" id="octaveValue">0</span><button class="smallbtn" id="octUp" aria-label="Octave suivante">+</button></div></div>
      <div><div class="tuningtitle">Sustain</div><div class="toggleline"><span style="font-size:12px">Maintien des notes</span><button class="switch" id="sustain" aria-label="Activer le sustain" aria-pressed="false"></button></div></div>
    </div>
    <div class="sliders">
      <label><div class="sliderlabel"><span>Volume</span><span id="volumeValue">70%</span></div><input id="volume" type="range" min="0" max="100" value="70"></label>
      <label><div class="sliderlabel"><span>Réverbération</span><span id="reverbValue">25%</span></div><input id="reverb" type="range" min="0" max="100" value="25"></label>
    </div>
  </div>

  <div class="panel keyboardpanel">
    <div class="keytop"><strong>CLAVIER VIRTUEL</strong><span id="noteStatus">Touchez une touche pour jouer</span></div>
    <div class="keys" id="keys" aria-label="Clavier de piano virtuel"><div class="keyinner" id="keyinner"></div></div>
    <p class="note">Faites glisser le clavier pour changer de zone. Le bas d’une touche joue plus fort que le haut. Le son est généré par synthèse audio dans le navigateur : ce sont des timbres synthétiques, pas des échantillons de piano professionnel.</p>
  </div>
</section>

<section id="page-sons" class="page">
  <div class="eyebrow">PALETTE SONORE</div><div class="sectionhead"><h2>CHOISIR UN INSTRUMENT</h2><span>Prototype audio</span></div>
  <div class="instruments">
    <button class="instrument active" data-sound="piano"><span class="symbol">🎹</span><span class="name">Piano</span></button>
    <button class="instrument" data-sound="soft"><span class="symbol">🎼</span><span class="name">Piano doux</span></button>
    <button class="instrument" data-sound="pad"><span class="symbol">☁️</span><span class="name">Pad Worship</span></button>
    <button class="instrument" data-sound="organ"><span class="symbol">🎛️</span><span class="name">Orgue Gospel</span></button>
    <button class="instrument" data-sound="strings"><span class="symbol">🎻</span><span class="name">Strings</span></button>
  </div>
  <div class="panel"><h2 style="font-size:14px;margin-top:0">Sons prévus</h2><p class="note">La version actuelle propose cinq timbres synthétiques. Toucher un instrument joue un Do pour l’écouter. L’ajout de sons réalistes nécessitera des banques audio adaptées et des essais de performances sur ton téléphone.</p></div>
</section>

<section id="page-midi" class="page">
  <div class="eyebrow">CONNEXION EXTERNE</div><div class="sectionhead"><h2>MIDI / CLAVIER EXTERNE</h2><span>État du système</span></div>
  <div class="panel">
    <div class="statusrow"><span class="dot" id="midiDot2"></span><div class="midistatus"><strong>Web MIDI</strong><small id="midiStatus2">Non vérifié sur cet appareil</small></div></div>
    <p class="note">La prise en charge dépend du navigateur Android, de son support Web MIDI et de l’adaptateur USB OTG. La connexion avec le Yamaha PSR-E463 n’est pas confirmée tant qu’un essai réel n’a pas été effectué.</p>
    <button class="actionbtn" id="midiConnect2" style="margin-top:12px">Rechercher les appareils MIDI</button>
    <div id="midiDevices" class="note" aria-live="polite"></div>
    <div class="lastnote" id="midiLast" aria-live="polite">Dernière note reçue : aucune pour l’instant</div>
  </div>
  <div class="panel"><h2 style="font-size:14px;margin-top:0">Pour le test à la maison</h2><ol class="note" style="padding-left:18px"><li>Brancher le clavier avec un adaptateur USB OTG compatible.</li><li>Ouvrir l’application dans Chrome (ou un navigateur compatible Web MIDI).</li><li>Toucher « Rechercher les appareils MIDI » et autoriser l’accès si demandé.</li><li>Jouer une note sur le Yamaha : elle doit apparaître ci-dessus et déclencher le son du téléphone.</li></ol></div>
</section>

<section id="page-reglages" class="page">
  <div class="eyebrow">PERSONNALISATION</div><div class="sectionhead"><h2>RÉGLAGES</h2><span>Wells Studio</span></div>
  <div class="panel">
    <div class="settingsrow"><span>Volume général</span><strong id="settingVolume">70%</strong></div>
    <div class="settingsrow"><span>Réverbération</span><strong id="settingReverb">25%</strong></div>
    <div class="settingsrow"><span>Tempo du métronome</span><div style="display:flex;align-items:center;gap:8px"><input id="tempo" type="range" min="40" max="200" value="80" style="width:100px" aria-label="Tempo"><strong id="tempoValue" style="min-width:58px;text-align:right">80 BPM</strong></div></div>
    <div class="settingsrow"><span>Séquence enregistrée</span><strong id="recInfo" style="font-size:11px;text-align:right">Aucune</strong></div>
    <div class="settingsrow"><span>Enregistrement</span><button class="actionbtn" id="exportRecording">Exporter la séquence MIDI</button></div>
    <div class="settingsrow"><span>Réinitialiser l’interface</span><button class="actionbtn" id="resetSettings">Réinitialiser</button></div>
  </div>
  <p class="note">Version 0.5 — interface et moteur audio prototype. L’export MIDI est une séquence de notes enregistrées (fichier .mid), pas un enregistrement audio WAV/MP3.</p>
</section>
</div>

<nav class="bottomnav" aria-label="Navigation principale">
  <button class="navitem active" data-page="piano"><span class="navico">🎹</span><span>Piano</span></button>
  <button class="navitem" data-page="sons"><span class="navico">♫</span><span>Sons</span></button>
  <button class="navitem" data-page="midi"><span class="navico">⌁</span><span>MIDI</span></button>
  <button class="navitem" data-page="reglages"><span class="navico">⚙</span><span>Réglages</span></button>
</nav>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(() => {
  "use strict";
  const $ = id => document.getElementById(id);

  /* ---------- Réglages ---------- */
  const SOUNDS = {piano:"Piano", soft:"Piano doux", pad:"Pad Worship", organ:"Orgue Gospel", strings:"Strings"};
  const PROGRAMS = {piano:0, soft:4, pad:89, organ:16, strings:48};
  const DEFAULTS = {sound:"piano", volume:70, reverb:25, octave:0, tempo:80};
  const STORE_KEY = "wwps-v05";
  const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
  let cfg = {...DEFAULTS};
  try {
    const s = JSON.parse(localStorage.getItem(STORE_KEY) || "null");
    if (s && typeof s === "object") {
      if (SOUNDS[s.sound]) cfg.sound = s.sound;
      if (Number.isFinite(s.volume)) cfg.volume = clamp(s.volume, 0, 100);
      if (Number.isFinite(s.reverb)) cfg.reverb = clamp(s.reverb, 0, 100);
      if (Number.isFinite(s.octave)) cfg.octave = clamp(Math.round(s.octave), -2, 2);
      if (Number.isFinite(s.tempo)) cfg.tempo = clamp(Math.round(s.tempo), 40, 200);
    }
  } catch (e) {}
  const save = () => { try { localStorage.setItem(STORE_KEY, JSON.stringify(cfg)); } catch (e) {} };

  /* ---------- Utilitaires ---------- */
  const NOTE_NAMES = ["Do","Do♯","Ré","Ré♯","Mi","Fa","Fa♯","Sol","Sol♯","La","La♯","Si"];
  const noteName = n => NOTE_NAMES[n % 12] + (Math.floor(n / 12) - 1);
  const midiToFreq = n => 440 * Math.pow(2, (n - 69) / 12);
  const LOGGED = new Set(["touch", "midi", "kbd"]);
  let toastTimer = null;
  function toast(message) {
    const t = $("toast"); t.textContent = message; t.style.display = "block";
    clearTimeout(toastTimer); toastTimer = setTimeout(() => { t.style.display = "none"; }, 2600);
  }

  /* ---------- Moteur audio ---------- */
  let audio = null, master = null, comp = null, bus = null, dry = null, wet = null, conv = null, vibGain = null;
  const voices = new Map();      // note -> voix en cours
  const sustained = new Set();   // notes relâchées mais tenues par le sustain
  let sustainOn = false, sustainFromPlay = false;

  function makeImpulse(ctx) {
    const rate = ctx.sampleRate, length = Math.floor(rate * 1.8), buf = ctx.createBuffer(2, length, rate);
    for (let ch = 0; ch < 2; ch++) {
      const d = buf.getChannelData(ch);
      for (let i = 0; i < length; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / length, 2.8);
    }
    return buf;
  }
  function ensureAudio() {
    if (!audio) {
      const Ctx = window.AudioContext || window.webkitAudioContext;
      if (!Ctx) { toast("Ce navigateur ne prend pas en charge l’audio Web."); return null; }
      try { audio = new Ctx({latencyHint: "interactive"}); } catch (e) { audio = new Ctx(); }
      master = audio.createGain();
      comp = audio.createDynamicsCompressor();
      comp.threshold.value = -16; comp.knee.value = 20; comp.ratio.value = 4; comp.attack.value = 0.004; comp.release.value = 0.2;
      master.connect(comp); comp.connect(audio.destination);
      bus = audio.createGain(); dry = audio.createGain(); wet = audio.createGain(); conv = audio.createConvolver();
      conv.buffer = makeImpulse(audio);
      bus.connect(dry); dry.connect(master); bus.connect(conv); conv.connect(wet); wet.connect(master);
      const vib = audio.createOscillator(); vib.frequency.value = 5.2;
      vibGain = audio.createGain(); vibGain.gain.value = 7;
      vib.conn
