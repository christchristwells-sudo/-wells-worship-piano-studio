.page{display:none}.page.active{display:block}
.note{font-size:10px;color:var(--muted);line-height:1.5;margin:10px 3px 0}
.settingsrow{display:flex;justify-content:space-between;align-items:center;padding:13px 0;border-bottom:1px solid #24374f;font-size:12px;gap:10px}
.settingsrow:last-child{border-bottom:0}
.actionbtn{border:1px solid var(--line);border-radius:10px;background:#142a44;padding:9px 12px;font-size:11px}
.lastnote{margin-top:12px;border:1px dashed #35506c;border-radius:12px;padding:11px 12px;font-size:12px;color:var(--gold2);font-variant-numeric:tabular-nums;min-height:40px}
.toast{position:fixed;left:50%;bottom:88px;transform:translateX(-50%);background:#f1d28c;color:#172237;padding:9px 14px;border-radius:11px;font-size:12px;font-weight:700;z-index:30;box-shadow:0 8px 30px #0007;display:none;max-width:90%;text-align:center}
@media(min-width:600px){.app{padding:24px 22px 110px}.brand h1{font-size:16px}.instrument{min-width:0}.keys{height:205px}.keyinner{height:190px}.whitekey{height:190px}.blackkey{height:116px}.panel{padding:16px}.control{min-height:62px}}
@media(max-width:370px){.app{padding-left:9px;padding-right:9px}.brand h1{font-size:12px}.instrument{min-width:96px}.keys{height:150px}.keyinner{height:138px}.whitekey{height:138px}.blackkey{height:86px}.control{font-size:9px}.panel{padding:10px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
