<div class="app">
<header>
  <div class="brand"><div class="logo">𝄞</div><div><h1>WELLS WORSHIP<br>PIANO STUDIO</h1><p>Jouez · Adorez · Élevez Sa présence</p></div></div>
  <button class="iconbtn" id="settingsShortcut" aria-label="Réglages">⚙</button>
</header>

<section id="page-piano" class="page active">
